{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/prisma-generate.js && tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx prisma/backup.ts",
    "db:restore": "tsx prisma/restoreBackup.ts",
    "storage:upload": "tsx prisma/uploadFixtures.ts",
    "storage:migrate-r2": "tsx scripts/migrate_to_r2.ts",
    "seed:fix-providers": "tsx prisma/fixProviders.ts",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@prisma/client": "6.19.3",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "6.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}