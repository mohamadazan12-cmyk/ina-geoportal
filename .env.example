# ==========================================================================
# INA-GEOPORTAL WEB APP REDESIGN v2.0 — Environment Configuration Template
# ==========================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is excluded by .gitignore.
# All values below are PLACEHOLDERS, not real credentials.
# ==========================================================================

# --------------------------------------------------------------------------
# RUNTIME
# --------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --------------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------------
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Neon PostgreSQL):
# Pooled connection string for runtime queries (port 6543 / -pooler):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Non-pooled direct connection string for Prisma migrations & DDL (port 5432):
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------------------------
# SECURITY — REQUIRED
# --------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Minimum 32 characters. Known-insecure defaults are rejected at startup.
JWT_SECRET="<GENERATE_A_RANDOM_64_BYTE_BASE64_SECRET>"

# Comma-separated allowed frontend origins.
# Leave EMPTY for same-origin Vercel deployment (recommended, no CORS needed).
# Example for a split frontend/backend:  CORS_ORIGIN="https://ina-geoportal.vercel.app"
CORS_ORIGIN=""

# --------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 / OPENID CONNECT (optional — legacy compatibility)
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --------------------------------------------------------------------------
# RATE LIMITING — Upstash Redis (required in production)
# --------------------------------------------------------------------------
# Create a free Redis database at https://console.upstash.com
# REST API section → copy the URL and token.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<UPSTASH_REST_TOKEN>"

# --------------------------------------------------------------------------
# FILE STORAGE & CLOUDFLARE R2
# --------------------------------------------------------------------------
# "local"       → read fixtures from server/src/fixtures (development only)
# "r2"          → Cloudflare R2 object storage for national datasets & archives
# "vercel-blob" → Vercel Blob object storage
# Auto-detected: "r2" when R2 credentials exist, else "vercel-blob" when BLOB_READ_WRITE_TOKEN is set, else "local"
STORAGE_DRIVER=local

# Cloudflare R2 Credentials (Zero-egress object storage for large national geospatial data)
# Obtain from: Cloudflare Dashboard → R2 Object Storage → Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ina-geoportal-data"
# Optional custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
# Cloudflare R2 Public Development URL (Phase 16.4.2)
R2_PUBLIC_URL="https://pub-9dc737b540c54b5597b47a06cbbda81e.r2.dev"

# Private blob store (Legacy Vercel Blob option)
# Original documents, dataset downloads and map layers.
BLOB_READ_WRITE_TOKEN="<VERCEL_BLOB_READ_WRITE_TOKEN>"

# Optional second store. Only needed if you want display layers physically
# separated from original downloads. Not required.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
PUBLIC_LAYER_BASE_URL=""

# --------------------------------------------------------------------------
# FRONTEND (Vite) — variables must be prefixed with VITE_
# --------------------------------------------------------------------------
# Same-origin deployment (recommended): use a relative path.
VITE_API_URL="/api/v1"
# Split deployment example:
# VITE_API_URL="https://ina-geoportal-api.vercel.app/api/v1"

# Legacy Google Identity Services client ID (UI no longer initiates GIS flow)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
