# ==========================================================================
# CLIENT (React + Vite) — Environment Template
# ==========================================================================
# Copy to `client/.env` for standalone frontend development.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never place secrets here — everything is public.
# ==========================================================================

# Same-origin deployment (recommended): relative path, resolved against the
# host that serves the SPA. The dev server proxies /api to localhost:5000.
VITE_API_URL="/api/v1"

# Split deployment example:
# VITE_API_URL="https://ina-geoportal-api.vercel.app/api/v1"

# Cloudflare R2 Public Base URL (public by design, CDN endpoint without credentials)
VITE_R2_PUBLIC_URL="https://pub-9dc737b540c54b5597b47a06cbbda81e.r2.dev"

# Legacy Google Identity Services client ID (public by design, not a secret).
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
