# ==========================================================================
# INA-GEOPORTAL WEB APP REDESIGN v2.0 — Root .gitignore
# ==========================================================================
# Repository hygiene + secret protection.
# See PHASE_14_P0_REMEDIATION_REPORT.md for remediation context.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. ENVIRONMENT FILES AND LOCAL SECRETS  (CRITICAL — never commit)
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example

# Variants that are commonly used for local overrides
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.backup
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# --------------------------------------------------------------------------
# 2. DEPENDENCIES
# --------------------------------------------------------------------------
node_modules/
node_modules
**/node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# --------------------------------------------------------------------------
# 3. BUILD OUTPUT AND ARTIFACTS
# --------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
**/dist/
**/build/
*.tsbuildinfo
.tsbuild/
.vite/
.turbo/
.next/
.nuxt/
.cache/

# --------------------------------------------------------------------------
# 4. TEST COVERAGE AND REPORTS
# --------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/

# --------------------------------------------------------------------------
# 5. LOCAL DATABASES (SQLite) — never commit real user data
# --------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
**/prisma/dev.db
**/prisma/*.db

# Prisma-generated client (regenerated via `prisma generate`)
**/generated/prisma/

# --------------------------------------------------------------------------
# 6. TEMPORARY FILES, LOGS AND DIAGNOSTICS
# --------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
.tmp/
temp/
tmp/

# --------------------------------------------------------------------------
# 7. OPERATING SYSTEM FILES
# --------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------------------------------
# 8. EDITOR / IDE CONFIGURATION
# --------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --------------------------------------------------------------------------
# 9. DEPLOYMENT PLATFORM CACHE
# --------------------------------------------------------------------------
.vercel
.vercel/**
.now
.netlify/
.firebase/

# --------------------------------------------------------------------------
# 10. MISC
# --------------------------------------------------------------------------
.eslintcache
.stylelintcache
*.orig
*.rej
.backup/
backups/

# ==========================================================================
# EXPLICITLY ALLOWED (application fixtures and assets must be versioned)
# ==========================================================================
# GeoJSON fixtures and demo data are legitimate application source assets.
!server/src/fixtures/geojson/*.json
!server/src/fixtures/**/*.geojson
!client/src/constants/demoGeojson/*.json

# --------------------------------------------------------------------------
# OBJECT STORAGE ARCHIVES (>100 MiB or raw uncompressed ingestion chunks)
# Stored on Cloudflare R2 / AWS S3 / Vercel Blob — never commit to GitHub (>100 MiB limit)
# --------------------------------------------------------------------------
server/src/fixtures/geojson/*_548.json
server/src/fixtures/geojson/*_full.json
server/src/fixtures/geojson/chunks_batas/
server/src/fixtures/geojson/chunks_gempa/
server/src/fixtures/geojson/tutupan_lahan_partitions/
server/src/fixtures/geojson/.*_checkpoint.json
.r2_migration_checkpoint.json
*.r2_migration_checkpoint.json
# UI image assets used by the Vite build
!client/src/assets/**
# Public static files (favicon, robots.txt, etc.)
!client/public/**
# Environment documentation with placeholders only
!.env.example
!**/.env.example
# Documentation and phase reports
!docs/**
!*.md
# Database migration history must be versioned
!server/prisma/migrations/**
!server/prisma/schema.prisma
